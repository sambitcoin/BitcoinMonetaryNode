     pindexNew->nDataPos = pos.nPos;
     pindexNew->nUndoPos = 0;
     pindexNew->nStatus |= BLOCK_HAVE_DATA;
+    // Assign the tiebreak score here, while the full block is in hand and
+    // before this index can be inserted into setBlockIndexCandidates below.
+    // It must never be recomputed: see the note on CBlockIndex::m_spam_score.
+    pindexNew->m_time_received = GetTime();
+    {
+        // A block that arrives after the race window of whichever block
+        // already holds this height is a straggler, not a contender: scoring
+        // it worst keeps us from reorging away a block we already accepted,
+        // onto the side that has by then already lost.
+        const CBlockIndex* incumbent{m_chain[pindexNew->nHeight]};
+        const int64_t delta{incumbent ? pindexNew->m_time_received - incumbent->m_time_received : 0};
+        const bool in_window{incumbent == nullptr || incumbent == pindexNew ||
+                             (delta >= 0 && delta <= node::SPAM_TIEBREAK_WINDOW_SECONDS)};
+        pindexNew->m_spam_score = in_window ? node::SpamScore(block)
+                                            : node::SPAM_SCORE_LATE;
+    }
     if (DeploymentActiveAt(*pindexNew, *this, Consensus::DEPLOYMENT_SEGWIT)) {
         pindexNew->nStatus |= BLOCK_OPT_WITNESS;
     }
