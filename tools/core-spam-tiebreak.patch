diff --git a/src/node/blockstorage.cpp b/src/node/blockstorage.cpp
index 8771c35..214351e 100644
--- a/src/node/blockstorage.cpp
+++ b/src/node/blockstorage.cpp
@@ -171,12 +171,43 @@ std::string CBlockFileInfo::ToString() const
 
 namespace node {
 
+std::atomic<bool> g_spam_tiebreak{false};
+
+uint32_t SpamScore(const CBlock& block)
+{
+    // NOT IMPLEMENTED. Returning 0 makes -spamtiebreak a no-op, which is the
+    // correct behaviour until a classifier is wired in here.
+    //
+    // The intended source is the project's existing carrier classifier
+    // (inscription envelopes, off-curve keys in bare multisig and P2PK,
+    // oversized OP_RETURN), reduced to a small number of buckets rather than
+    // a byte count. It must be deterministic: two nodes scoring the same
+    // block differently would disagree about the tip, which defeats the
+    // purpose.
+    (void)block;
+    return 0;
+}
+
 bool CBlockIndexWorkComparator::operator()(const CBlockIndex* pa, const CBlockIndex* pb) const
 {
+    // Note the convention: this returns true when `pa` is WORSE than `pb`.
+    // setBlockIndexCandidates is read via rbegin(), so the greatest element
+    // is the best candidate. Inverting any of these comparisons silently
+    // selects the worse block with no error anywhere.
+
     // First sort by most total work, ...
     if (pa->nChainWork > pb->nChainWork) return false;
     if (pa->nChainWork < pb->nChainWork) return true;
 
+    // ... then, if enabled, by data-carrier content: at equal work, prefer
+    // the block carrying less spam. This is policy, not consensus. Both
+    // blocks remain valid and neither is rejected; the moment either chain is
+    // extended the work comparison above decides and this never runs.
+    if (g_spam_tiebreak.load(std::memory_order_relaxed) &&
+        pa->m_spam_score != pb->m_spam_score) {
+        return pa->m_spam_score > pb->m_spam_score;
+    }
+
     // ... then by earliest activatable time, ...
     if (pa->nSequenceId < pb->nSequenceId) return false;
     if (pa->nSequenceId > pb->nSequenceId) return true;
