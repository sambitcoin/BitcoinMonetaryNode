 // containers), or make the key a `std::unique_ptr<CBlockIndex>`
 using BlockMap = std::unordered_map<uint256, CBlockIndex, BlockHasher>;
 
+/** When set, equal-work block candidates are ordered by data-carrier content
+ *  before arrival order. Policy only: no block is rejected, and most-work
+ *  still decides as soon as either chain is extended.
+ *
+ *  A global because CBlockIndexWorkComparator is default-constructed at its
+ *  call sites and carries no state. Plumbing it through options would be
+ *  cleaner and is the obvious review comment. */
+extern std::atomic<bool> g_spam_tiebreak;
+
+/** Data-carrier bytes in a block, bucketed coarsely.
+ *
+ *  Coarse on purpose. Ranking by exact byte counts would make chain selection
+ *  sensitive to classifier edge cases; buckets keep a false positive from
+ *  changing the answer unless it is a large one. */
+uint32_t SpamScore(const CBlock& block);
+
 struct CBlockIndexWorkComparator {
