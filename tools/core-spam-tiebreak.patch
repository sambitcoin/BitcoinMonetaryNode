diff --git a/src/node/blockstorage.cpp b/src/node/blockstorage.cpp
index 8771c35..6bd7a9c 100644
--- a/src/node/blockstorage.cpp
+++ b/src/node/blockstorage.cpp
@@ -171,12 +171,47 @@ std::string CBlockFileInfo::ToString() const
 
 namespace node {
 
+std::atomic<bool> g_spam_tiebreak{false};
+
+uint32_t SpamScore(const CBlock& block)
+{
+    // NOT IMPLEMENTED. Returning 0 makes -spamtiebreak a no-op, which is the
+    // correct behaviour until a classifier is wired in here.
+    //
+    // The intended source is the project's existing carrier classifier
+    // (inscription envelopes, off-curve keys in bare multisig and P2PK,
+    // oversized OP_RETURN), reduced to a small number of buckets rather than
+    // a byte count. It must be deterministic: two nodes scoring the same
+    // block differently would disagree about the tip, which defeats the
+    // purpose.
+    (void)block;
+    return 0;
+}
+
 bool CBlockIndexWorkComparator::operator()(const CBlockIndex* pa, const CBlockIndex* pb) const
 {
+    // Note the convention: this returns true when `pa` is WORSE than `pb`.
+    // setBlockIndexCandidates is read via rbegin(), so the greatest element
+    // is the best candidate. Inverting any of these comparisons silently
+    // selects the worse block with no error anywhere.
+
     // First sort by most total work, ...
     if (pa->nChainWork > pb->nChainWork) return false;
     if (pa->nChainWork < pb->nChainWork) return true;
 
+    // ... then, if enabled, by data-carrier content: at equal work, prefer
+    // the block carrying less spam. This is policy, not consensus. Both
+    // blocks remain valid and neither is rejected; the moment either chain is
+    // extended the work comparison above decides and this never runs.
+    // Blocks that arrived after the race window closed carry SPAM_SCORE_LATE
+    // and therefore sort worst, so a straggler can never displace an
+    // incumbent. The window is folded into the score rather than gated by a
+    // flag, to keep this a strict weak ordering -- see SPAM_SCORE_LATE.
+    if (g_spam_tiebreak.load(std::memory_order_relaxed) &&
+        pa->m_spam_score != pb->m_spam_score) {
+        return pa->m_spam_score > pb->m_spam_score;
+    }
+
     // ... then by earliest activatable time, ...
     if (pa->nSequenceId < pb->nSequenceId) return false;
     if (pa->nSequenceId > pb->nSequenceId) return true;
diff --git a/src/node/blockstorage.h b/src/node/blockstorage.h
index 8869ee2..7b9b1b1 100644
--- a/src/node/blockstorage.h
+++ b/src/node/blockstorage.h
@@ -135,6 +135,46 @@ inline constexpr uint32_t UNDO_DATA_DISK_OVERHEAD{STORAGE_HEADER_BYTES + uint256
 // containers), or make the key a `std::unique_ptr<CBlockIndex>`
 using BlockMap = std::unordered_map<uint256, CBlockIndex, BlockHasher>;
 
+/** When set, equal-work block candidates are ordered by data-carrier content
+ *  before arrival order. Policy only: no block is rejected, and most-work
+ *  still decides as soon as either chain is extended.
+ *
+ *  A global because CBlockIndexWorkComparator is default-constructed at its
+ *  call sites and carries no state. Plumbing it through options would be
+ *  cleaner and is the obvious review comment. */
+extern std::atomic<bool> g_spam_tiebreak;
+
+/** How long after the incumbent block arrived a challenger may still win the
+ *  content tiebreak, in seconds.
+ *
+ *  Past this, the race is over: the network has converged, and switching
+ *  would mean reorging away a block we already accepted onto the side that
+ *  already lost. Compact-block propagation reaches most of the network in a
+ *  few seconds, so this is generous by design rather than tuned. */
+static constexpr int64_t SPAM_TIEBREAK_WINDOW_SECONDS{30};
+
+/** Score assigned to a block that arrived after the race window closed.
+ *
+ *  Worst-possible rather than a separate "ineligible" flag, and that is not a
+ *  stylistic choice. A flag makes the comparison depend on BOTH operands'
+ *  flags, which destroys transitivity: with A(7, eligible), B(0, eligible,
+ *  later) and C(5, ineligible, middle) you get B beats A on score, C beats B
+ *  on arrival, A beats C on arrival -- a cycle. std::set with an intransitive
+ *  comparator is undefined behaviour and corrupts silently.
+ *
+ *  Folding the window into the score keeps the ordering a plain lexicographic
+ *  composition of total orders, so it is a strict weak ordering by
+ *  construction. A late block simply sorts worst and can never displace an
+ *  incumbent, which is exactly the intended semantics. */
+static constexpr uint32_t SPAM_SCORE_LATE{std::numeric_limits<uint32_t>::max()};
+
+/** Data-carrier bytes in a block, bucketed coarsely.
+ *
+ *  Coarse on purpose. Ranking by exact byte counts would make chain selection
+ *  sensitive to classifier edge cases; buckets keep a false positive from
+ *  changing the answer unless it is a large one. */
+uint32_t SpamScore(const CBlock& block);
+
 struct CBlockIndexWorkComparator {
     bool operator()(const CBlockIndex* pa, const CBlockIndex* pb) const;
     using is_transparent = void;
