diff --git a/src/policy/policy.cpp b/src/policy/policy.cpp
--- a/src/policy/policy.cpp
+++ b/src/policy/policy.cpp
@@
+bool g_reject_parasites{DEFAULT_REJECT_PARASITES};
+bool g_reject_tokens{DEFAULT_REJECT_TOKENS};
+bool g_permit_bare_pubkey{DEFAULT_PERMIT_BARE_PUBKEY};
+bool g_permit_bare_datacarrier{DEFAULT_PERMIT_BARE_DATACARRIER};
+bool g_accept_nonstd_datacarrier{DEFAULT_ACCEPT_NONSTD_DATACARRIER};
+unsigned int g_datacarrier_cost{DEFAULT_DATACARRIER_COST};
+unsigned int g_max_script_size{DEFAULT_MAX_SCRIPT_SIZE};
+
+/** Is this pubkey a real point on secp256k1?
+ *
+ *  Data stuffed into a pubkey field is overwhelmingly not on the curve,
+ *  because the stuffer does not care and cannot easily arrange otherwise.
+ *  Checking the curve is therefore a far better detector than checking a
+ *  key prefix — an earlier version of the monetary node's scanner checked
+ *  the prefix and reported Stamps at zero for weeks as a result.
+ *
+ *  y^2 = x^3 + 7 (mod p), decided by Euler's criterion.
+ */
+static bool IsOnCurve(const std::vector<unsigned char>& pubkey)
+{
+    if (pubkey.size() != 33 && pubkey.size() != 65) return false;
+    CPubKey key(pubkey);
+    return key.IsFullyValid();
+}
+
+bool HasInscriptionEnvelope(const CTransaction& tx)
+{
+    for (const auto& txin : tx.vin) {
+        const auto& stack = txin.scriptWitness.stack;
+        if (stack.size() < 2) continue;
+
+        // Taproot script-path: the script is the second-from-last element,
+        // after any annex. P2WSH: the script is the last element.
+        size_t script_idx = stack.size() - 1;
+        if (!stack.empty() && stack.back().size() > 0
+            && stack.back()[0] == 0x50 && stack.size() >= 2) {
+            script_idx = stack.size() - 2;   // annex present
+        }
+        if (stack.size() >= 3) script_idx = stack.size() - 2;
+        if (script_idx >= stack.size()) continue;
+
+        const CScript script(stack[script_idx].begin(), stack[script_idx].end());
+        CScript::const_iterator pc = script.begin();
+        opcodetype op;
+        std::vector<unsigned char> push;
+        bool last_push_false{false};
+        bool last_push_true{false};
+
+        while (pc < script.end()) {
+            if (!script.GetOp(pc, op, push)) break;
+
+            // The envelope signature: an unexecutable branch guarded by a
+            // push whose truth value makes the branch dead, used purely to
+            // park bytes inside a script that will never run them.
+            if (op == OP_IF && last_push_false) return true;
+            if (op == OP_NOTIF && last_push_true) return true;
+
+            if (op == OP_0 || (push.size() == 1 && push[0] == 0x00)) {
+                last_push_false = true; last_push_true = false;
+            } else if (op == OP_1 || (push.size() == 1 && push[0] == 0x01)) {
+                last_push_true = true; last_push_false = false;
+            } else {
+                last_push_false = false; last_push_true = false;
+            }
+        }
+    }
+    return false;
+}
+
+bool IsUnwantedDataCarrier(const CScript& script)
+{
+    // Bare pubkey (P2PK) whose "key" is not a curve point is a data field
+    // wearing a key's clothes.
+    std::vector<std::vector<unsigned char>> solutions;
+    const TxoutType type = Solver(script, solutions);
+
+    if (type == TxoutType::PUBKEY && !g_permit_bare_pubkey) {
+        if (!solutions.empty() && !IsOnCurve(solutions[0])) return true;
+    }
+    if (type == TxoutType::MULTISIG) {
+        for (size_t i = 1; i + 1 < solutions.size(); ++i) {
+            if (!IsOnCurve(solutions[i])) return true;
+        }
+    }
+    return false;
+}
+
+/** Runestone and similar token protocols: OP_RETURN OP_13 <payload>.
+ *
+ *  Deliberately narrow. Rejecting every OP_RETURN that begins with a small
+ *  opcode would catch unrelated protocols, and -rejecttokens defaults off
+ *  precisely because this classification is a policy opinion rather than a
+ *  structural fact.
+ */
+static bool IsTokenScript(const CScript& script)
+{
+    if (script.size() < 2 || script[0] != OP_RETURN) return false;
+    return script[1] == OP_13;
+}
@@ bool IsStandardTx(const CTransaction& tx, ...)
     }

+    if (g_reject_parasites && HasInscriptionEnvelope(tx)) {
+        reason = "parasitic-envelope";
+        return false;
+    }
+
+    unsigned int datacarrier_outputs{0};
     for (const CTxOut& txout : tx.vout) {
+        if (txout.scriptPubKey.size() > g_max_script_size) {
+            reason = "script-size";
+            return false;
+        }
+        if (g_reject_parasites && IsUnwantedDataCarrier(txout.scriptPubKey)) {
+            reason = "datacarrier-in-key-field";
+            return false;
+        }
+        if (g_reject_tokens && IsTokenScript(txout.scriptPubKey)) {
+            reason = "token-output";
+            return false;
+        }
+        if (txout.scriptPubKey.IsUnspendable()) ++datacarrier_outputs;
     }
+
+    // A transaction whose every output is a data carrier moves no value and
+    // is not a payment. Knots declines to relay these by default.
+    if (!g_permit_bare_datacarrier && !tx.vout.empty()
+        && datacarrier_outputs == tx.vout.size()) {
+        reason = "bare-datacarrier";
+        return false;
+    }

