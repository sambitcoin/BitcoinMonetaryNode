+    def _is_coin_uneconomic_dust(self, utxo: PartialTxInput) -> bool:
+        """If true, the coin is too small to be worth spending at typical fee
+        rates, so it is implicitly frozen and stays out of coin selection.
+
+        This is a spending preference, not a claim that the coin is worthless.
+        The coin stays in the wallet, it is counted in the frozen balance, and
+        an explicit per-coin unfreeze takes precedence over this rule (see
+        is_frozen_coin, which checks user-set state first and returns early).
+        A coin that is uneconomic at 50 sat/vB is spendable at 2 sat/vB, so
+        the threshold is a setting rather than a constant.
+        """
+        if not self.config.WALLET_FREEZE_DUST_UTXOS:
+            return False
+        threshold = self.config.WALLET_FREEZE_DUST_UTXO_THRESHOLD_SAT
+        if threshold <= 0:
+            return False
+        value_sats = utxo.value_sats()
+        assert value_sats is not None
+        return value_sats < threshold
+
